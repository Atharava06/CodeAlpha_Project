# Server Port
PORT=5000

# Client origin for CORS (Vite default is http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Translation Provider: 'google' | 'azure' | 'mymemory'
# - 'google': Google Cloud Translation API v2 (requires GOOGLE_TRANSLATE_API_KEY)
# - 'azure': Microsoft Azure Translator API v3 (requires AZURE_TRANSLATOR_KEY & REGION)
# - 'mymemory': MyMemory Public Translation API (works out-of-the-box for instant testing without API credentials)
TRANSLATION_PROVIDER=google

# Google Cloud Translation API Key
# Sign up and generate an API key at https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here

# Microsoft Azure Translator API credentials (optional)
# Sign up at https://portal.azure.com and create a Translator resource
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus
